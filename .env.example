# Which model route Forge uses:
#   local     Ollama on this machine (default)
#   openai    any OpenAI-compatible server: Ollama /v1, llama.cpp (llama-server), LM Studio, MLX (mlx_lm.server)
#   aistudio  Gemma hosted on Google AI Studio
FORGE_ROUTE=local

# Models, context and speech are picked from this computer's memory (run `forge doctor` to see the profile).
# Set any of these to override it.
OLLAMA_URL=http://127.0.0.1:11434
# FORGE_FAST_MODEL=gemma4:e4b
# FORGE_AGENT_MODEL=gemma4:e4b          # 24 GB+ Macs default to gemma4:12b-it-qat for the screen agent
# OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=10m

# OpenAI-compatible route (FORGE_ROUTE=openai): the server's URL and the model name it serves
#   Ollama http://127.0.0.1:11434/v1 · llama.cpp http://127.0.0.1:8080/v1 · LM Studio http://127.0.0.1:1234/v1
#   MLX (mlx_lm.server) http://127.0.0.1:8080/v1
FORGE_OPENAI_URL=http://127.0.0.1:11434/v1
# FORGE_OPENAI_MODEL=gemma4:e4b
# FORGE_OPENAI_KEY=                     # only if your server wants one

# AI Studio route: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
FORGE_AISTUDIO_MODEL=gemma-4-26b-a4b-it

# Speech recognition: Whisper small.en on the Apple GPU (~0.2 s a command).
# accurate = large-v3-turbo (~0.8 s, better with strong accents and noise)
# FORGE_STT_MODEL=accurate

# Listening (Monday's rules; see AGENTS.md section 5)
# FORGE_CLAP=1                          # double clap wakes Forge
# FORGE_ACK=chime                       # chime or speak on wake
# FORGE_CONVERSE_S=8                    # seconds after a reply with no wake word needed (0 = always need it)
# FORGE_END_MS=550                      # silence that ends a phrase (raise it if Forge cuts you off)
# FORGE_FINISH_S=1.8                    # extra wait for unfinished sentences ("I want you to...")
# FORGE_VAD_LEVEL=3                     # speech detector strictness 0-3 (2 if quiet speech is missed)
# FORGE_NOISE_REDUCE=1                  # clean each phrase before Whisper (0 = lower latency)
# FORGE_VOICE_LOCK=0                    # 1: only your enrolled voice commands Forge (run `forge enroll` once)
# FORGE_VOICE_THRESH=                   # voice lock threshold override
# FORGE_DEBUG=0                         # 1: one line per phrase explaining what was heard (~/.forge/debug.log)

# Voice (Kokoro, on device)
# FORGE_TTS=kokoro
# FORGE_TTS_VOICE=af_bella*0.6+af_sky*0.4
# FORGE_TTS_SPEED=1.12

FORGE_MAX_STEPS=12                      # screen agent step cap
# FORGE_CODE_MAX_STEPS=40               # Code mode: steps per request
# FORGE_PLAN=0                          # turn off planning (compound requests become a checklist first)
# FORGE_TRACE_DIR=traces
