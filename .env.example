# Monday Studio (Code + Computer). The voice agent is the Monday program in monday/monday,
# with its own settings in monday/monday/.env.

# Which model route Studio uses:
#   local     Ollama on this machine (default)
#   openai    any OpenAI-compatible server: Ollama /v1, llama.cpp (llama-server), LM Studio, MLX (mlx_lm.server)
#   aistudio  Gemma hosted on Google AI Studio
FORGE_ROUTE=local

# Models and context are picked from this computer's memory (run `monday doctor` to see the profile).
# Set any of these to override it.
OLLAMA_URL=http://127.0.0.1:11434
# FORGE_FAST_MODEL=gemma4:e4b
# FORGE_AGENT_MODEL=gemma4:e4b          # the screen agent; 12B QAT / 26B A4B are optional, bigger picks
# OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m

# OpenAI-compatible route (FORGE_ROUTE=openai): the server's URL and the model name it serves
#   Ollama http://127.0.0.1:11434/v1 · llama.cpp http://127.0.0.1:8080/v1 · LM Studio http://127.0.0.1:1234/v1
#   MLX (mlx_lm.server) http://127.0.0.1:8080/v1
FORGE_OPENAI_URL=http://127.0.0.1:11434/v1
# FORGE_OPENAI_MODEL=gemma4:e4b
# FORGE_OPENAI_KEY=                     # only if your server wants one

# AI Studio route (optional): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
FORGE_AISTUDIO_MODEL=gemma-4-26b-a4b-it

# Studio's push-to-talk mic button: Whisper small.en (~0.2 s); accurate = large-v3-turbo
# FORGE_STT_MODEL=accurate

# Agents
FORGE_MAX_STEPS=12                      # screen agent step cap
# FORGE_CODE_MAX_STEPS=40               # Code mode: steps per request
# FORGE_PLAN=0                          # turn off planning (compound requests become a checklist first)
# FORGE_TRACE_DIR=traces

# Where the Monday voice agent lives (default: monday/monday in this folder)
# MONDAY_DIR=/path/to/monday
